{
	"compilerOptions": {
		"module": "commonjs",
		"noEmit": true,
		"target": "ESNext",
		"checkJs": true,
		"allowJs": true,
		"alwaysStrict": true,
		"resolveJsonModule": true,
		"strict": true,
		"types": [
			"node"
		],
		"lib": [
			"ESNext",
			"DOM"
		]
	},
	"exclude": [
		"node_modules"
	],
	"include": [
		"src/**/*"
	]
}